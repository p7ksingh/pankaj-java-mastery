{
  "name": "javabypankaj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npx ts-node --skip-project --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' scripts/build-search-index.ts && npx ts-node --skip-project --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' scripts/build-sitemap.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typesense": "^3.2.0"
  },
  "devDependencies": {
    "@jest/types": "29.6.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "dotenv": "^18.0.9",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.6",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
